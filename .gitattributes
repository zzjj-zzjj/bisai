# 统一换行符，避免 Windows 下 CRLF 污染 diff
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
*.pptx binary
*.zip binary

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 锁文件不在 diff 中折叠，便于审查依赖变更
package-lock.json -diff linguist-generated
pnpm-lock.yaml -diff linguist-generated

# Markdown 视为文档
*.md linguist-documentation
docs/** linguist-documentation
